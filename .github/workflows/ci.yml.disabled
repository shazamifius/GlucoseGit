name: CI

# Ce que tout commit doit tenir, et que la machine vérifie à la place de la discipline :
# le formatage, le linter strict sans aucune alarme éteinte, tous les tests, et le noyau sans
# dépendance. Ce sont les critères de sortie que les fiches 04 (0.6) et 11 (A) demandaient.
#
# Deux plateformes : Windows, où le projet est développé et mesuré, et Linux, pour que la
# portabilité soit constatée plutôt qu'affirmée.

on:
  push:
    branches: [main]
  pull_request:

env:
  CARGO_TERM_COLOR: always

jobs:
  verify:
    name: ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, ubuntu-latest]
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt

      # `rfd` ouvre les dialogues natifs par GTK 3 sous Linux ; c'est la seule bibliothèque
      # système que le workspace demande à la compilation.
      - name: Dépendances système (Linux)
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y libgtk-3-dev pkg-config

      - uses: Swatinem/rust-cache@v2

      - name: Formatage
        run: cargo fmt --all -- --check

      - name: Clippy strict
        run: cargo clippy --workspace --all-targets -- -D warnings

      - name: Tests
        run: cargo test --workspace

      # `cargo tree` n'imprime que le noyau lui-même quand il ne dépend de rien : une ligne.
      - name: Le noyau n'a aucune dépendance
        shell: bash
        run: |
          lignes=$(cargo tree -p glucose-core -e normal | wc -l)
          echo "cargo tree -p glucose-core : $lignes ligne(s)"
          test "$lignes" -eq 1
