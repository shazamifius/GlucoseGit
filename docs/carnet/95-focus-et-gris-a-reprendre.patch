+//! GRIS-1 — de loin, un nœud montre le gris de ses lignes, et ce gris est ce que ses lettres
+//! couvrent : la moyenne de son dessin de près.
+
+use crate::app::GlucoseApp;
+use glucose_core::types::{Annotation, Viewport};
+
+const TAILLE: (u32, u32) = (900, 700);
+/// Le nœud : 600 × 400 du monde, son coin à (0, 0).
+const NOEUD: (f64, f64) = (600.0, 400.0);
+
+const TEXTE: &str = "# L'eau\n\nL'eau est un composé chimique ubiquitaire sur la Terre, essentiel \
+pour tous les organismes vivants connus. Elle se trouve en général dans son état liquide et \
+possède à température ambiante des propriétés uniques : c'est notamment un solvant efficace.\n\n\
+- une molécule polaire\n- trois états\n- un cycle";
+
+/// La couleur moyenne de l'intérieur du nœud, vu à ce zoom — son coin posé à (100, 150) de
+/// l'écran. L'intérieur : le nœud sans le dixième de chaque bord, là où ni coin arrondi ni
+/// liseré ne tombent.
+fn moyenne(zoom: f64) -> [f64; 3] {
+    let mut app = GlucoseApp::new();
+    let board = app.store.project.active_board_id.clone();
+    if let Some(b) = app.store.active_board_mut() {
+        b.annotations.clear();
+    }
+    let mut t = Annotation::text("t", 0.0, 0.0, TEXTE);
+    if let Annotation::Text { width, height, .. } = &mut t {
+        (*width, *height) = (Some(NOEUD.0), Some(NOEUD.1));
+    }
+    app.store.add_annotation(&board, t);
+    app.store.clear_selection();
+    let (x0, y0) = (100.0, 150.0);
+    app.store.set_viewport(
+        &board,
+        Viewport {
+            x: x0,
+            y: y0,
+            scale: zoom,
+        },
+    );
+    app.une_image_sans_fenetre(TAILLE);
+    let p = app.pixmap.as_ref().expect("une image");
+    let (l, h) = (NOEUD.0 * zoom, NOEUD.1 * zoom);
+    let (gauche, haut) = ((x0 + l * 0.1) as usize, (y0 + h * 0.1) as usize);
+    let (droite, bas) = ((x0 + l * 0.9) as usize, (y0 + h * 0.9) as usize);
+    let mut somme = [0.0f64; 3];
+    for y in haut..bas {
+        for x in gauche..droite {
+            let c = p.pixels()[y * p.width() as usize + x].demultiply();
+            for (s, v) in somme.iter_mut().zip([c.red(), c.green(), c.blue()]) {
+                *s += f64::from(v);
+            }
+        }
+    }
+    let n = ((droite - gauche) * (bas - haut)) as f64;
+    somme.map(|s| s / n)
+}
+
+/// **Vu de loin, le nœud a la couleur moyenne de son dessin de près**, à quelques pour cent de
+/// l'écart que le texte fait à la brume. Le cadre vide d'avant (SCALE-2) n'en montrait que la
+/// brume : la preuve à l'envers est l'écart lui-même, qu'il faut d'abord voir exister.
+#[test]
+fn gris_1_de_loin_le_noeud_garde_la_couleur_de_ses_lettres() {
+    let pres = moyenne(1.0);
+    let loin = moyenne(0.1);
+    let brume = moyenne_d_une_brume();
+    let ecart_du_texte: f64 = (0..3).map(|k| (pres[k] - brume[k]).abs()).sum();
+    assert!(
+        ecart_du_texte > 6.0,
+        "le texte doit se voir de près : {pres:?} contre {brume:?}"
+    );
+    let ecart: f64 = (0..3).map(|k| (loin[k] - pres[k]).abs()).sum();
+    eprintln!("MESURE gris : loin {loin:?}, près {pres:?}, brume {brume:?}, écart {ecart:.2} sur {ecart_du_texte:.2}");
+    assert!(
+        ecart < ecart_du_texte * 0.25,
+        "de loin {loin:?}, de près {pres:?}, la brume {brume:?}"
+    );
+}
+
+/// La couleur moyenne du même nœud, vide : sa brume seule.
+fn moyenne_d_une_brume() -> [f64; 3] {
+    let mut app = GlucoseApp::new();
+    let board = app.store.project.active_board_id.clone();
+    if let Some(b) = app.store.active_board_mut() {
+        b.annotations.clear();
+    }
+    let mut t = Annotation::text("t", 0.0, 0.0, " ");
+    if let Annotation::Text { width, height, .. } = &mut t {
+        (*width, *height) = (Some(NOEUD.0), Some(NOEUD.1));
+    }
+    app.store.add_annotation(&board, t);
+    app.store.clear_selection();
+    app.store.set_viewport(
+        &board,
+        Viewport {
+            x: 100.0,
