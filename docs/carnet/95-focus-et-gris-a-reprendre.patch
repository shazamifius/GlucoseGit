+fn draw_paper_gris(
+    ctx: &Pass,
+    pixmap: &mut PixmapMut,
+    at: (f32, f32),
+    layout: &StickyLayout,
+    (paper, lines): (&Paper<'_>, &[(usize, usize)]),
+) {
+    let zoom = ctx.scale.world(1.0);
+    if zoom <= 0.0 {
+        return;
+    }
+    let floor = at.1 + layout.height - layout.pad;
+    let mut y = at.1 + layout.pad;
