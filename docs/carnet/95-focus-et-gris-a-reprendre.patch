         "sans la réserve, un grand titre aurait dû couvrir son voisin"
     );
 }
+
+/// **TITRE-1 — les coupes comptent la place des titres** : des sous-membranes titrées, de
+/// surfaces très diverses ; la plus haute colonne, titres compris, est l'optimum exact (la force
+/// brute) pour le nombre de colonnes retenu. Des coupes calculées sur les seules boîtes
+/// laisseraient une colonne plus haute que nécessaire.
+#[test]
+fn titre_1_les_coupes_comptent_la_place_des_titres() {
+    for graine in 0..20u64 {
+        let enfants: Vec<Bloc> = hauteurs(graine, 9)
+            .into_iter()
+            .enumerate()
+            // Larges et basses, de largeurs très diverses : leurs titres pèsent autant que leurs
+            // boîtes, et changent les coupes — des membranes de surface ordinaire ne les changeaient
+            // pas, et l'épreuve passait par la chance de ses données.
+            .map(|(i, h)| Bloc {
+                id: format!("m{i}"),
+                largeur: 300.0 * (1 + (i * 7 + graine as usize) % 40) as f64,
+                hauteur: h,
+                enfants: Vec::new(),
+                titree: true,
+            })
+            .collect();
+        let reelles: Vec<f64> = enfants
+            .iter()
+            .map(|b| crate::membrane_titre::surcroit(b.largeur, b.hauteur) + b.hauteur)
+            .collect();
+        let racine = Bloc {
+            id: "r".into(),
+            largeur: 300.0,
+            hauteur: 100.0,
+            enfants,
+            titree: true,
+        };
+        let boites: std::collections::HashMap<String, Rect> =
+            disposer(&racine, 1.6, M).into_iter().collect();
+        let mut gauches: Vec<f64> = (0..9).map(|i| boites[&format!("m{i}")].left).collect();
+        gauches.dedup();
+        let haute = boites["r"].height - M.titre - M.ecart;
+        let juste = optimum(&reelles, gauches.len());
+        assert!(
+            (haute - juste).abs() < 1e-6,
+            "graine {graine} : la plus haute colonne {haute}, l'optimum {juste}"
+        );
+    }
+}
