@@ -0,0 +1,63 @@
+//! **GRIS-1 — de loin, le gris de chaque ligne** (fiche 95).
+//!
+//! Sous un cinquième de zoom, une lettre fait moins de trois pixels : elle ne se lit plus. Glucose
+//! posait alors le cadre vide du nœud (SCALE-2) — un long article et un nœud vide se
+//! ressemblaient. Sa parole du 8/11 : *« pas de LOD, pas de simplification »* ; devant la
+//! proposition, *« carrément d'accord pour le gris des lignes »*.
+//!
+//! Vu de loin, un texte **est** un gris : l'encre de ses lettres répartie sur la place de ses
+//! lignes. Chaque ligne se peint donc comme un rectangle de son encre, à l'opacité de son encre
+//! sur sa place — sa largeur fois la hauteur d'une ligne —, par la loi des membranes, qui donne à
+//! chaque pixel sa couverture exacte (MEMB-FORME-1) : un paragraphe garde sa forme, ses lignes
+//! courtes, son retrait, ses titres plus sombres ; rien n'est remplacé ni caché.
+
+use super::{CardLayout, TextCard};
+use crate::renderer::pass::Pass;
+use crate::renderer::richtext::{indent_of, ink_of, TextLayout};
+use glucose_core::membrane_forme::{peindre, Arrondi, Membrane};
+use tiny_skia::{Color, PixmapMut};
+
+/// **Une ligne vue de loin** : le rectangle `(x, y, largeur, hauteur)` de l'écran, peint de cette
+/// encre à l'opacité de son `encre` sur sa `place` — la surface de ses lettres sur celle de sa
+/// ligne, toutes deux à la taille du monde. La loi des nœuds de texte et celle des post-it.
+pub(crate) fn ligne_grise(
+    pixmap: &mut PixmapMut,
+    (x, y, largeur, hauteur): (f32, f32, f32, f32),
+    (encre, place): (f32, f32),
+    couleur: Color,
+) {
+    if !(encre > 0.0 && place > 0.0) {
+        return;
+    }
+    let forme = Arrondi::nouveau(x, y, largeur, hauteur, 0.0);
+    let opacite = (encre / place).min(1.0) * couleur.alpha();
+    let teinte = [couleur.red(), couleur.green(), couleur.blue()];
+    let (l, h) = (pixmap.width(), pixmap.height());
+    let (pixels, _) = pixmap.data_mut().as_chunks_mut::<4>();
+    peindre(&Membrane::plein(forme, teinte, opacite), pixels, l, h);
+}
+
+/// **Le gris des lignes de ce nœud**, sous son cadre et sa brume déjà posés.
+pub(super) fn draw_card_gris(
+    ctx: &Pass,
+    pixmap: &mut PixmapMut,
+    at: (f32, f32),
+    (layout, text, _card): (&CardLayout, &TextLayout, &TextCard),
+) {
+    let zoom = ctx.scale.world(1.0);
+    if zoom <= 0.0 || layout.line_height <= 0.0 {
+        return;
+    }
+    let hauteur_monde = layout.line_height / zoom;
+    let mut y = at.1 + layout.pad_y;
+    for line in &text.lines {
+        let x = at.0 + layout.pad_x + indent_of(line.kind, layout.indent);
+        let boite = (x, y, line.largeur * zoom, layout.line_height);
+        let mesure = (line.encre, line.largeur * hauteur_monde);
+        ligne_grise(pixmap, boite, mesure, ink_of(line.kind, ctx.theme));
+        y += layout.line_height;
+    }
+}
+
+#[cfg(test)]
+mod tests;
