+/// **Les cadres des images choisies passent par la carte** (CADRES-1) : tout choisir sur huit mille
+/// images peignait trente-deux mille filets, et toute la couche du dessus repartait à chaque image.
+/// La couche du dessus ne les porte plus, et les deux voies montrent le même trait.
+#[test]
+fn test_cadres_1_les_cadres_droits_passent_par_la_carte() {
+    let Some((peripherique, file)) = banc_gpu::carte() else {
+        banc_gpu::sans_carte();
+        return;
+    };
+    let taille = (800, 600);
+    let mut store = document_damier(1.0);
+    let board = store.project.active_board_id.clone();
+    let id = store
+        .project
+        .boards
+        .iter()
+        .find(|b| b.id == board)
+        .expect("le tableau")
+        .images[0]
+        .id
+        .clone();
+    store.select_image(id, false);
+    let (renderer, dessous, dessus, confie) = les_deux_couches_decodees(taille, &store);
+    assert_eq!(
+        confie.cadres_choisis.len(),
+        4,
+        "quatre filets pour une photo choisie"
+    );
+    let carte = banc_gpu::composer_les_cinq_temps(
+        (&peripherique, &file),
+        taille,
+        &confie,
+        (&dessous, &dessus),
+        &|cle| confie.pixels(&renderer, cle),
+    )
+    .expect("la composition");
+    let processeur = par_le_processeur_decode(taille, &store);
+    // Le milieu du filet du haut, sur la boîte de la photo (x = 300 à 500, y = 200).
+    let filet = confie.cadres_choisis[0].rect;
+    let (x, y) = ((filet.x() + filet.width() / 2.0) as u32, filet.y() as u32);
+    let encre = pixel(&processeur, x, y);
+    assert_eq!(pixel(&carte, x, y), encre, "le même trait, à la même place");
+    assert_eq!(
+        dessus.pixel(x, y).map(|p| p.alpha()),
+        Some(0),
+        "la couche du dessus ne le porte plus"
+    );
+    // Rien de choisi : rien à poser, et rien de parcouru.
+    store.clear_selection();
+    let (_, _, _, sans) = les_deux_couches_decodees(taille, &store);
+    assert!(sans.cadres_choisis.is_empty());
+}
