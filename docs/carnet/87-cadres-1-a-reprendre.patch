+/// La boîte d'une image à l'écran : le modèle la place par son centre.
+fn boite_a_l_ecran(
+    img: &glucose_core::types::BoardImage,
+    vp: &glucose_core::types::Viewport,
+) -> (f32, f32, f32, f32) {
+    let (x, y) = world_to_screen(img.x - img.width / 2.0, img.y - img.height / 2.0, vp);
+    let (l, h) = (img.width * vp.scale, img.height * vp.scale);
+    (x as f32, y as f32, l as f32, h as f32)
+}
