+pub(super) fn cadres_a_poser(
+    theme: &super::Theme,
+    store: &Store,
+    pass: ViewPass<'_>,
+) -> Vec<super::zone::Rectangle> {
+    let Some(board) = store
+        .active_board()
+        .filter(|_| !store.selected_image_ids.is_empty())
+    else {
+        return Vec::new();
+    };
+    let images = Visibles::nouvelles(pass.visibles, board)
+        .images()
+        .map(|img| (img, boite_a_l_ecran(img, &pass.vp)));
+    filets_des_choisies(theme, store, pass.echelle(), images)
 }
 
